# Copia este archivo como `.env` en la raíz del repo.
# NO subas `.env` al repositorio (contiene secretos).
#
# Nota: algunas variables se usan solo en Docker (Influx init), otras en Django.

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
SECRET_KEY_DJANGO=change-me
# Django lee DEBUG_DJANGO como string; usa true/false.
DEBUG_DJANGO=true

# Listas separadas por coma (django-environ env.list)
ALLOWED_HOSTS_DEV=localhost,127.0.0.1
# ALLOWED_HOSTS_PROD=tu-dominio.com

# CORS/CSRF (ajusta según dónde sirvas el frontend)
CORS_ALLOWED_ORIGINS_DEV=http://localhost:3000
CORS_ORIGIN_WHITELIST_DEV=http://localhost:3000
CSRF_TRUSTED_ORIGINS_DEV=http://localhost:3000

# CORS_ALLOW_METHODS_DEV se lee como lista
CORS_ALLOW_METHODS_DEV=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Opcional: headers extra permitidos (además de default_headers)
# CORS_ALLOW_HEADERS_DEV=content-type,x-csrftoken

# Si vas a usar valores PROD, define también:
# CORS_ALLOWED_ORIGINS_PROD=https://tu-dominio.com
# CORS_ORIGIN_WHITELIST_PROD=https://tu-dominio.com
# CSRF_TRUSTED_ORIGINS_PROD=https://tu-dominio.com


# -----------------------------------------------------------------------------
# Postgres (Django ORM)
# -----------------------------------------------------------------------------
POSTGRES_DB=energymonitor
POSTGRES_USER=energymonitor
POSTGRES_PASSWORD=energymonitor
# En Docker: dbPostgres | Local: localhost
POSTGRES_HOST=dbPostgres


# -----------------------------------------------------------------------------
# InfluxDB (contenedor) - usado por docker-compose para el setup inicial
# -----------------------------------------------------------------------------
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=adminadmin
INFLUX_ORG=EnergyOrg
# Solo para init: el backend igual usa buckets fijos Energia/Acumuladores/Sensores
INFLUX_BUCKET=Energia


# -----------------------------------------------------------------------------
# InfluxDB (cliente backend)
# -----------------------------------------------------------------------------
# En Docker: http://dbInflux:8086 | Local: http://localhost:8086
INFLUX_URL=http://dbInflux:8086
INFLUX_TOKEN=
INFLUX_ORG=EnergyOrg
INFLUX_TIMEOUT_MS=10000


# -----------------------------------------------------------------------------
# Loops / tiempo real / background
# -----------------------------------------------------------------------------
INTERVALO_REFRESCO=1
INTERVALO_MODBUS_SEGUNDOS=5
INTERVALO_OPC_SEGUNDOS=5

# Si tienes más de un worker/proceso y quieres evitar loops duplicados:
# ENABLE_BACKGROUND_TASKS=false
ENABLE_BACKGROUND_TASKS=true


# -----------------------------------------------------------------------------
# OPC UA
# -----------------------------------------------------------------------------
# URL del servidor OPC UA (ajusta a tu entorno)
OPC_URL=opc.tcp://localhost:4840


# -----------------------------------------------------------------------------
# URL base del backend para hilos (nombre histórico: POSTGRES_URL)
# -----------------------------------------------------------------------------
# Local: http://localhost:8000/api/ | Docker: http://backend:8000/api/
POSTGRES_URL=http://backend:8000/api/
